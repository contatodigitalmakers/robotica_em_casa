---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../config/site';
import { funilHref, localeHref, localeMeta, locales } from '../lib/locales';

interface Props {
  title: string;
  description: string;
  skipLink: string;
  locale?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, skipLink, locale, noindex = false, jsonLd = [] } = Astro.props;

const idioma = localeMeta(locale ?? Astro.currentLocale);
const lang = idioma.htmlLang;
const canonical = new URL(Astro.url.pathname, site.url).href;
const funil = Astro.url.pathname.startsWith('/up')
  ? 'up'
  : Astro.url.pathname.startsWith('/down')
    ? 'down'
    : Astro.url.pathname.startsWith('/obrigado')
      ? 'obrigado'
      : null;
const alternates = locales.map((l) => ({
  hreflang: l.hreflang,
  href: new URL(funil ? funilHref(funil, l.code) : localeHref(l.code, Astro.url.pathname), site.url).href,
}));
const xDefault = new URL(
  funil ? funilHref(funil, 'pt-br') : localeHref('pt-br', Astro.url.pathname),
  site.url
).href;
const ogImage = new URL('/og-image.jpg', site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.empresa.nome,
  url: site.url,
  logo: new URL('/favicon.png', site.url).href,
  email: site.empresa.emailSuporte,
  address: { '@type': 'PostalAddress', streetAddress: site.empresa.endereco, addressCountry: 'BR' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta name="theme-color" content="#1F2A44" />

    <!-- checkout: resolve DNS cedo, sem conexão completa -->
    <link rel="dns-prefetch" href="https://pay.hotmart.com" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={idioma.og} />
    <meta property="og:site_name" content={site.marca} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ícones -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{skipLink}</a>
    <slot />
  </body>
</html>
