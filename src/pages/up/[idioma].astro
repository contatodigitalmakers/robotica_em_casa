---
import Upsell from '../../components/Upsell.astro';
import type { LocaleCode } from '../../lib/locales';

export function getStaticPaths() {
  return (['en', 'es', 'fr', 'it'] as const).map((idioma) => ({ params: { idioma } }));
}

const idioma = Astro.params.idioma as LocaleCode;
---

<Upsell locale={idioma} />
