---
import { Picture } from 'astro:assets';
import Pill from './Pill.astro';
import Button from './Button.astro';
import type { Content } from '../content';
import logo from '../assets/img/logo.png';

interface Props {
  c: Content['hero'];
}

const { c } = Astro.props;
---

<section class="hero" id="topo" data-hero>
  <!-- blobs orgânicos em CSS puro (o LCP é o H1, sem imagem de fundo) -->
  <div class="hero__blobs" aria-hidden="true">
    <span class="blob blob--1"></span>
    <span class="blob blob--2"></span>
    <span class="blob blob--3"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__selo">
      <Picture
        src={logo}
        widths={[132, 264]}
        sizes="132px"
        formats={['avif', 'webp']}
        alt={c.mascoteAlt}
        width={1024}
        height={1024}
        loading="eager"
        decoding="async"
      />
    </div>

    <Pill emoji={c.pillEmoji} label={c.pill} tone="yellow" />

    <h1>
      {c.tituloPre}<span class="hl hl--yellow">{c.tituloDestaque}</span>{c.tituloPos}
    </h1>

    <p class="hero__sub">{c.subtitulo}</p>

    <Button href="#ofertas" label={c.cta} size="lg" />
    <p class="hero__micro">{c.microcopy}</p>

    <ul class="hero__feats" role="list">
      {c.destaques.map((d) => (
        <li>
          <strong>{d.titulo}</strong>
          <span>{d.texto}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--text-on-dark);
    padding: clamp(40px, 7vw, 88px) 0 var(--section-pad);
  }

  .hero__blobs .blob--1 {
    width: 340px;
    height: 340px;
    top: -120px;
    left: -100px;
    background: radial-gradient(circle, var(--blue), transparent 65%);
    opacity: 0.4;
  }

  .hero__blobs .blob--2 {
    width: 300px;
    height: 300px;
    top: 10%;
    right: -110px;
    background: radial-gradient(circle, var(--pink), transparent 65%);
    opacity: 0.32;
  }

  .hero__blobs .blob--3 {
    width: 380px;
    height: 380px;
    bottom: -160px;
    left: 22%;
    background: radial-gradient(circle, var(--yellow), transparent 65%);
    opacity: 0.22;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }

  .hero__selo {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--cream);
    border: 4px solid var(--kraft);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(13, 19, 36, 0.35);
  }

  .hero__selo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  h1 {
    max-width: 16ch;
  }

  .hero__sub {
    max-width: 56ch;
    font-size: 1.08rem;
    color: var(--text-on-dark-muted);
  }

  .hero__micro {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-on-dark-muted);
    margin-top: -10px;
  }

  .hero__feats {
    list-style: none;
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: 880px;
    margin-top: 18px;
  }

  .hero__feats li {
    background: var(--navy-2);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: var(--radius-card);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__feats strong {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--yellow);
  }

  .hero__feats span {
    font-size: 0.92rem;
    color: var(--text-on-dark-muted);
  }

  @media (min-width: 768px) {
    .hero__feats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
