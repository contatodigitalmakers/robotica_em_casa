---
import Pill from './Pill.astro';
import Icon from './Icon.astro';
import type { Content } from '../content';

interface Props {
  c: Content['garantia'];
}

const { c } = Astro.props;
---

<section class="section garantia cv" id="garantia" aria-labelledby="t-garantia">
  <div class="container garantia__inner">
    <Pill emoji={c.pillEmoji} label={c.pill} tone="green" />
    <div class="garantia__card">
      <span class="garantia__escudo" aria-hidden="true">
        <Icon name="shield" size={44} />
      </span>
      <div>
        <h2 id="t-garantia">{c.titulo}</h2>
        <p>{c.texto}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .garantia {
    background: var(--cream);
  }

  .garantia__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 860px;
  }

  .garantia__card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: var(--green-card);
    border: 2px solid var(--green);
    border-radius: var(--radius-card);
    padding: clamp(24px, 4vw, 40px);
  }

  .garantia__escudo {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--green);
    color: var(--white);
    display: grid;
    place-items: center;
  }

  .garantia__card h2 {
    margin-bottom: 10px;
  }

  .garantia__card p {
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .garantia__card {
      flex-direction: column;
    }
  }
</style>
