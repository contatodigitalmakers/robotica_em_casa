---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getContent } from '../content';

interface Secao {
  h: string;
  p: string[];
}

interface Props {
  bloco: { title: string; description: string; secoes: Secao[] };
}

const { bloco } = Astro.props;
const c = getContent(Astro.currentLocale);
---

<Base title={`${bloco.title} | Robótica em Casa`} description={bloco.description} skipLink={c.a11y.pular}>
  <Header c={c.header} />
  <main id="conteudo" class="legal">
    <div class="container legal__inner">
      <p class="legal__aviso">{c.legal.avisoRevisao}</p>
      <h1>{bloco.title}</h1>
      <p class="legal__atualizado">{c.legal.atualizado}</p>

      {bloco.secoes.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((paragrafo) => <p>{paragrafo}</p>)}
        </section>
      ))}
    </div>
  </main>
  <Footer c={c.footer} a11y={c.a11y} />
</Base>

<style>
  .legal {
    background: var(--cream);
    padding: clamp(40px, 7vw, 80px) 0;
  }

  .legal__inner {
    max-width: 760px;
  }

  .legal__aviso {
    display: inline-block;
    background: var(--yellow-tint);
    color: var(--orange-dark);
    font-weight: 800;
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 18px;
  }

  .legal h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin-bottom: 8px;
  }

  .legal__atualizado {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 32px;
  }

  .legal section {
    margin-bottom: 28px;
  }

  .legal h2 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }

  .legal section p {
    color: var(--text-muted);
    margin-bottom: 10px;
  }
</style>
