---
/**
 * Ícones SVG inline (sem pacote de ícones).
 * Uso: <Icon name="robot" /> — cor via currentColor (defina `color` no CSS pai).
 */
interface Props {
  name: 'robot' | 'recycle' | 'flask' | 'scissors' | 'search' | 'check' | 'check-circle' | 'shield' | 'star' | 'arrow-right' | 'arrow-left' | 'close' | 'lock' | 'quote';
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

{ name === 'robot' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="5" y="8" width="14" height="11" rx="3" />
    <path d="M12 8V4.5" />
    <circle cx="12" cy="3.2" r="1.3" fill="currentColor" stroke="none" />
    <circle cx="9.4" cy="12.5" r="1.15" fill="currentColor" stroke="none" />
    <circle cx="14.6" cy="12.5" r="1.15" fill="currentColor" stroke="none" />
    <path d="M9.8 15.8c.6.6 1.4.9 2.2.9s1.6-.3 2.2-.9" />
    <path d="M5 12H3m18 0h-2" />
  </svg>
)}

{ name === 'recycle' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7.5 7 10 3.2c.4-.6 1.3-.6 1.7 0l1.6 2.4" />
    <path d="m13.3 5.6-1.7 2.5 3 .5" />
    <path d="m20 15.5-2.4 3.7c-.4.6-1.3.6-1.7 0l-1.5-2.4" />
    <path d="m14.4 16.8 3 .5-1.6 2.4" />
    <path d="m8.5 19.2-3.1-.1c-.7 0-1.1-.8-.8-1.4l1.6-2.6" />
    <path d="m6.2 15.1-1.7 2.5-3-.4" />
  </svg>
)}

{ name === 'flask' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 3v5.5L4.6 17.6A2 2 0 0 0 6.4 20.5h11.2a2 2 0 0 0 1.8-2.9L14 8.5V3" />
    <path d="M8.5 3h7" />
    <path d="M7.2 14.5h9.6" />
    <circle cx="11" cy="17" r=".9" fill="currentColor" stroke="none" />
    <circle cx="13.6" cy="16" r=".7" fill="currentColor" stroke="none" />
  </svg>
)}

{ name === 'scissors' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="6" cy="6.5" r="2.5" />
    <circle cx="6" cy="17.5" r="2.5" />
    <path d="M8.1 8 20 19M8.1 16 20 5" />
  </svg>
)}

{ name === 'search' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="m20 20-4.8-4.8" />
    <path d="M10.5 7.8v5.4M7.8 10.5h5.4" />
  </svg>
)}

{ name === 'check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m4.5 12.5 5 5 10-11" />
  </svg>
)}

{ name === 'check-circle' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="m8 12.3 2.8 2.7L16.5 9" />
  </svg>
)}

{ name === 'shield' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2.8 4.5 5.5v5.2c0 4.6 3.2 8.4 7.5 10.5 4.3-2.1 7.5-5.9 7.5-10.5V5.5Z" />
    <path d="m8.6 11.8 2.4 2.4 4.4-4.6" />
  </svg>
)}

{ name === 'star' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2.6c.3 0 .6.2.7.4l2.5 5.3 5.8.7c.7.1 1 .9.5 1.4l-4.3 4 1.1 5.7c.1.7-.6 1.2-1.2.9L12 18l-5.1 2.8c-.6.3-1.3-.2-1.2-.9l1.1-5.7-4.3-4c-.5-.5-.2-1.3.5-1.4l5.8-.7 2.5-5.3c.1-.2.4-.4.7-.4Z" />
  </svg>
)}

{ name === 'arrow-right' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 12h15m-6-7 7 7-7 7" />
  </svg>
)}

{ name === 'arrow-left' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 12H5m6 7-7-7 7-7" />
  </svg>
)}

{ name === 'close' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
    <path d="M6 6l12 12M18 6 6 18" />
  </svg>
)}

{ name === 'lock' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="5" y="10.5" width="14" height="9.5" rx="2.5" />
    <path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7" />
    <circle cx="12" cy="15.2" r="1.2" fill="currentColor" stroke="none" />
  </svg>
)}

{ name === 'quote' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M10.2 5.5C6.4 7 4 10.2 4 14.6c0 2.7 1.6 4.4 3.8 4.4 2 0 3.5-1.4 3.5-3.4 0-1.9-1.3-3.2-3.1-3.2-.3 0-.7 0-.8.1.3-2 1.9-3.9 3.9-4.8l-1.1-2.2Zm9.5 0c-3.8 1.5-6.2 4.7-6.2 9.1 0 2.7 1.6 4.4 3.8 4.4 1.9 0 3.5-1.4 3.5-3.4 0-1.9-1.4-3.2-3.2-3.2-.3 0-.6 0-.7.1.3-2 1.8-3.9 3.8-4.8l-1-2.2Z" />
  </svg>
)}
